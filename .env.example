APP_NAME=BrandPulse API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

POSTGRES_DB=brandpulse
POSTGRES_USER=brandpulse
POSTGRES_PASSWORD=brandpulse_dev
DATABASE_URL=postgresql+asyncpg://brandpulse:brandpulse_dev@localhost:5432/brandpulse
TEST_DATABASE_URL=postgresql+asyncpg://brandpulse:brandpulse_dev@localhost:5432/brandpulse_test

REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RSS_REQUEST_TIMEOUT_SECONDS=30
COLLECTOR_POLL_SECONDS=10

# OpenAI-compatible model provider. Never commit real keys.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=

# Embedding provider used by the local pgvector knowledge base.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=30
